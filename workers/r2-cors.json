{
  "rules": [
    {
      "allowed": {
        "origins": ["https://voiceboxstudio.pages.dev", "http://localhost:3000"],
        "methods": ["GET", "PUT", "HEAD"],
        "headers": ["content-type", "range"]
      },
      "exposeHeaders": ["ETag", "Content-Length", "Content-Range"],
      "maxAgeSeconds": 3600
    }
  ]
}
